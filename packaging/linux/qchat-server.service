# systemd unit installed by the qchat-server .deb and .rpm packages. It is
# deploy/systemd/qchat-server.service with the binary in /usr/bin; keep the
# two in sync. The package does not enable or start the service: create the
# identity first (see /usr/share/doc/qchat-server/README.systemd.md).
[Unit]
Description=qchat relay server
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/qchat/server.toml

[Service]
Type=simple
User=qchat
Group=qchat
ExecStart=/usr/bin/qchat-server run --config /etc/qchat/server.toml
Restart=on-failure
RestartSec=5

# ProtectSystem=strict makes /etc read-only for the server, so server.toml
# needs database = "/var/lib/qchat/qchat.db" in the writable state directory.
StateDirectory=qchat
StateDirectoryMode=0700
ReadWritePaths=/var/lib/qchat

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native

CapabilityBoundingSet=
# If the server listens on a port below 1024, set:
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
